@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Dashboard</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- Custom Admin Styles -->
    <link rel="stylesheet" href="~/css/admin.css" />
</head>

<body>
    <div class="admin-layout d-flex">
        <!-- Sidebar -->
        <aside class="sidebar bg-dark text-light d-flex flex-column p-3 position-fixed">
            <div class="profile-section text-center mb-4">
                <div class="profile-avatar mb-2">
                    <i class="bi bi-person-circle fs-1"></i>
                </div>
                <div class="profile-name fw-semibold">Admin Name</div>
                <a href="#" class="profile-edit text-secondary small text-decoration-none">Edit Profile</a>
            </div>

            <ul class="nav nav-pills flex-column mb-auto">
                <li class="nav-item">
                    <a asp-controller="Admin" asp-action="Dashboard" class="nav-link text-light">
                        <i class="bi bi-grid me-2"></i> Dashboard
                    </a>
                </li>
                <li>
                    <a asp-controller="ClientHistory" asp-action="Index" class="nav-link text-light">
                        <i class="bi bi-person-lines-fill me-2"></i> Client History
                    </a>
                </li>
                <li>
                    <a asp-controller="Payments" asp-action="Index" class="nav-link text-light">
                        <i class="bi bi-credit-card me-2"></i> Payment
                    </a>
                </li>
                <li class="nav-item">
    <a asp-controller="Admin" asp-action="Calendar" class="nav-link d-flex align-items-center text-light">
        <i class="bi bi-calendar-event me-2"></i>
        <span>Calendar</span>
    </a>
</li>
                <li>
                    <a asp-controller="ApplicationUsers" asp-action="Index" class="nav-link text-light">
                        <i class="bi bi-people me-2"></i> Users
                    </a>
                </li>
                <li>
                    <a asp-controller="AuditLogs" asp-action="Index" class="nav-link text-light">
                        <i class="bi bi-journal-text me-2"></i> Audit Logs
                    </a>
                </li>
                <li>
                    <a asp-controller="Settings" asp-action="Index" class="nav-link text-light">
                        <i class="bi bi-gear me-2"></i> Settings
                    </a>
               <li class="mt-auto">
    <form asp-controller="AccountApi" asp-action="LogoutGet" method="get" class="nav-link text-light">
        <button type="submit" class="nav-link text-danger btn btn-link p-0 border-0">
            <i class="bi bi-box-arrow-right me-2"></i> Log Out
        </button>
    </form>
</li>


            </ul>
        </aside>

        <!-- Main Content -->
        <div class="main-content flex-grow-1">
            <header class="main-header d-flex align-items-center justify-content-between px-4 py-3 border-bottom">
                <button class="btn btn-outline-light d-md-none" id="menuToggle" aria-label="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
                <h5 class="text-light m-0">@ViewData["Title"]</h5>

                <div class="notification-bell position-relative">
                    <i class="bi bi-bell text-light fs-5"></i>
                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger rounded-circle"></span>
                </div>
            </header>

            <main class="content-body p-4">
                @RenderBody()
            </main>
        </div>
    </div>

    @RenderSection("Scripts", required: false)

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        const sidebar = document.querySelector('.sidebar');
        const menuToggle = document.getElementById('menuToggle');
        menuToggle?.addEventListener('click', () => sidebar.classList.toggle('active'));
    </script>
</body>
</html>
