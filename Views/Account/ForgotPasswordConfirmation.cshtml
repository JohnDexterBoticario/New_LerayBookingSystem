@{
    ViewData["Title"] = "Password Reset Sent";
}

<div class="d-flex align-items-center justify-content-center py-5">
    <div class="card p-5 shadow-lg text-center" style="max-width: 500px; width: 100%;">
        <i class="fa-solid fa-envelope-circle-check fa-5x text-success mb-4"></i>
        <h2 class="card-title mb-3 text-success">Check Your Inbox</h2>
        <p class="mb-4">
            If an account with that email address exists in our system, we have sent a password reset link to it.
        </p>
        <p class="text-muted small">
            Please check your spam folder if you do not see the email within a few minutes.
        </p>
        
        <a href="/Home/Index" class="btn btn-primary mt-4">Return to Login</a>
    </div>
</div>