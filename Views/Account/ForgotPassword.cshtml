@model New_LeRayBookingSystem.Models.DTOs.ForgotPasswordDto
@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/forgot-password.css" />

<div class="forgot-container">
    <div class="forgot-box">
        <h2>Forgot Password</h2>
        <p>Enter your email address to receive a password reset link.</p>

        <form asp-action="ForgotPassword" method="post" id="forgotForm">
            <div class="form-group">
                <input asp-for="Email" type="email" placeholder="Email address" required />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="btn-submit">Send Reset Link</button>
        </form>

        <p class="login-link mt-3">
            Remembered your password? <a asp-controller="Account" asp-action="Login">Log In</a>
        </p>
    </div>
</div>

@section Scripts {
    <script src="~/js/forgot-password.js"></script>
}
