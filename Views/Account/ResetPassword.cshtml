@model New_LeRayBookingSystem.Models.DTOs.ResetPasswordDto
@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/reset-password.css" />

<div class="reset-container">
    <div class="reset-box">
        <h2>Reset Your Password</h2>
        <p>Enter a new password for your account.</p>

        <form asp-action="ResetPassword" method="post" id="resetForm">
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="Token" />

            <div class="form-group">
                <input asp-for="NewPassword" type="password" placeholder="New Password" required />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input asp-for="ConfirmPassword" type="password" placeholder="Confirm Password" required />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-submit">Reset Password</button>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/reset-password.js"></script>
}
