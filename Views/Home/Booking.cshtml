                                <label for="service-n6">Gel Mani & Pedi – ₱850</label>
                            </div>
                            <div class="service-item">
                                <input type="checkbox" name="services[]" value="70" data-price="999" id="service-n7"> @* ID 70 assumed *@@* **VERIFY ID** *@
                                <label for="service-n7">Softgel/Polygel Builder – ₱999</label>
                            </div>
                            <div class="service-item">
                                <input type="checkbox" name="services[]" value="71" data-price="1199" id="service-n8"> @* ID 71 assumed *@@* **VERIFY ID** *@
