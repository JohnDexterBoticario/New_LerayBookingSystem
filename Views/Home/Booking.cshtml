                            <div class="service-item">
                                <input type="checkbox" name="services[]" value="66" data-price="350" id="service-n3"> @* ID 66 assumed *@@* **VERIFY ID** *@
                                <label for="service-n3">Mani & Pedi – ₱350</label>
                            </div>
                            <div class="service-item">
                                <input type="checkbox" name="services[]" value="67" data-price="450" id="service-n4"> @* ID 67 assumed *@@* **VERIFY ID** *@
                                <label for="service-n4">Gel Manicure – ₱450</label>
                            </div>
                            <div class="service-item">
                                <input type="checkbox" name="services[]" value="68" data-price="480" id="service-n5"> @* ID 68 assumed *@@* **VERIFY ID** *@
                                <label for="service-n5">Gel Pedicure – ₱480</label>
