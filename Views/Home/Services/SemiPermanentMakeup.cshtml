@{
    ViewData["Title"] = "Semi-Permanent Makeup";
}
@section Styles {
    <link rel="stylesheet" href="~/css/facial_style.css" asp-append-version="true" />
}
  <h2 class="title">SEMI PERMANENT MAKE-UP SERVICES *PER SESSION</h2>

  <div class="facial-grid">
    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/BB Glow(FACE).jpg" alt="BB GLOW (Face)" class="facial-img">
      <span class="price">₱1,599 / Session</span>
      <h3>BB GLOW (FACE)</h3>
      <p>A semi-permanent foundation treatment for the face to even out skin tone. Available in Neutral, Light, Light Rose, Medium, Deep, and Deep Plus shades.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/BB Glow Face and neck.png" alt="BB GLOW (Face and Neck)" class="facial-img">
      <span class="price">₱1,999 / Session</span>
      <h3>BB GLOW (FACE AND NECK)</h3>
      <p>Extends the BB GLOW treatment to cover both the face and the neck for seamless, radiant coverage.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/.jpg" alt="BB blush (Face and Blush)" class="facial-img">
      <span class="price">₱1,999 / Session</span>
      <h3>BB GLOW (FACE AND BLUSH)</h3>
      <p>Combines BB GLOW on the face with a subtle, natural-looking semi-permanent blush application.</p>
    
    <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/Neck.png" alt="BB GLOW (Neck)" class="facial-img">
      <span class="price">₱599 / Session</span>
      <h3>BB GLOW (NECK)</h3>
      <p>Targeted BB GLOW application specifically for evening out the skin tone on the neck area.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/BB blush" alt="BB BLUSH" class="facial-img">
      <span class="price">₱599 / Session</span>
    
      <h3>BB BLUSH</h3>
      <p>A semi-permanent treatment that infuses natural color to the cheeks, creating a subtle, lasting rosy glow.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/BB lips.png" alt="BB LIPS" class="facial-img">
      <span class="price">₱1,699 / Session</span>
      <h3>BB LIPS</h3>
      <p>A semi-permanent color infusion to the lips for a natural tint, improving lip tone and appearance.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/Full package.png" alt="FULL FACE PACKAGE" class="facial-img">
      <span class="price">₱4,199 / Package</span>
      <h3>FULL FACE PACKAGE</h3>
      <p>Comprehensive package including semi-permanent treatment for the **Face, Neck, Lips, and Blush**.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>

    <div class="facial-card">
      <img src="~/Images/SemiPemanentMakeupServices/FACE,NECK,blush.png" alt="FACE, NECK, AND BLUSH PACKAGE" class="facial-img">
      <span class="price">₱2,600 / Package</span>
      <h3>FACE, NECK, AND BLUSH</h3>
      <p>A package covering the semi-permanent treatment of the **Face, Neck, and Blush** areas.</p>
      <a href="/Home/Booking" class="book-btn">BOOK NOW</a>
    </div>
  </div>
  @section Scripts {
    <script src="~/js/Services_script.js" asp-append-version="true"></script>
}