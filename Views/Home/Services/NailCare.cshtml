@{
    ViewData["Title"] = "Nail Care";
}
@section Styles {
    <link rel="stylesheet" href="~/css/facial_style.css" asp-append-version="true" />
}
  <h2 class="title">SERVICES</h2>

  <div class="facial-grid">
        <div class="facial-card">
